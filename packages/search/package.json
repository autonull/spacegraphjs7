{
  "name": "@spacegraphjs/search",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./GraphSearch": {
      "types": "./dist/GraphSearch.d.ts",
      "import": "./dist/GraphSearch.js",
      "default": "./dist/GraphSearch.js"
    },
    "./GraphFind": {
      "types": "./dist/GraphFind.d.ts",
      "import": "./dist/GraphFind.js",
      "default": "./dist/GraphFind.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@spacegraphjs/shared": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "2.11.10",
    "vitest": "^5.0.0"
  },
  "sideEffects": false
}