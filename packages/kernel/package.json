{
    "name": "@spacegraphjs/kernel",
    "version": "0.1.0",
    "description": "Graph kernel for SpaceGraphJS hosts",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build": "vite build"
    },
    "devDependencies": {
        "@spacegraphjs/renderer": "workspace:*"
    },
    "license": "MIT"
}
