{
  "name": "@spacegraphjs/adapter",
  "version": "0.1.0",
  "description": "Host-agnostic model adapter: turns a domain graph model into the renderer contract's RenderModel",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spacegraphjs/renderer": "workspace:*"
  },
  "license": "MIT"
}
