{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "spacegraphjs": ["../../src/index.ts"],
      "spacegraphjs/*": ["../../src/*"],
      "@spacegraphjs/renderer": ["../../packages/renderer/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
