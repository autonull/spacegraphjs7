{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "baseUrl": ".",
        "paths": {
            "spacegraphjs/layout-registry": ["../../src/core/layout-registry.ts"],
            "@spacegraphjs/renderer": ["../renderer/src/index.ts"],
            "@spacegraphjs/adapter": ["../adapter/src/index.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
