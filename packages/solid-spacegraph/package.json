{
  "name": "solid-spacegraph",
  "version": "1.0.0",
  "description": "SolidJS binding for the SpaceGraphJS renderer contract",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "solid-js": ">=1.8",
    "spacegraphjs": "workspace:*"
  },
  "devDependencies": {
    "@spacegraphjs/renderer": "workspace:*",
    "solid-js": "^1.9.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.10.2"
  },
  "scripts": {
    "build": "vite build"
  }
}
