{
    "name": "@spacegraphjs/navigation",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./GraphBreadcrumbs": {
            "types": "./dist/GraphBreadcrumbs.d.ts",
            "import": "./dist/GraphBreadcrumbs.js",
            "default": "./dist/GraphBreadcrumbs.js"
        },
        "./GraphMinimap": {
            "types": "./dist/GraphMinimap.d.ts",
            "import": "./dist/GraphMinimap.js",
            "default": "./dist/GraphMinimap.js"
        },
        "./GraphLegend": {
            "types": "./dist/GraphLegend.d.ts",
            "import": "./dist/GraphLegend.js",
            "default": "./dist/GraphLegend.js"
        },
        "./GraphLegendBody": {
            "types": "./dist/GraphLegendBody.d.ts",
            "import": "./dist/GraphLegendBody.js",
            "default": "./dist/GraphLegendBody.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "dependencies": {
        "@spacegraphjs/shared": "workspace:*"
    },
    "devDependencies": {
        "solid-js": "^1.9.0",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vite-plugin-solid": "2.11.10",
        "vitest": "^5.0.0"
    },
    "sideEffects": false
}
