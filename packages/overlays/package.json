{
    "name": "@spacegraphjs/overlays",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./GraphPeek": {
            "types": "./dist/GraphPeek.d.ts",
            "import": "./dist/GraphPeek.js",
            "default": "./dist/GraphPeek.js"
        },
        "./GraphPopover": {
            "types": "./dist/GraphPopover.d.ts",
            "import": "./dist/GraphPopover.js",
            "default": "./dist/GraphPopover.js"
        },
        "./GraphOverlayManager": {
            "types": "./dist/GraphOverlayManager.d.ts",
            "import": "./dist/GraphOverlayManager.js",
            "default": "./dist/GraphOverlayManager.js"
        },
        "./ScopedOverlay": {
            "types": "./dist/ScopedOverlay.d.ts",
            "import": "./dist/ScopedOverlay.js",
            "default": "./dist/ScopedOverlay.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "dependencies": {
        "@spacegraphjs/shared": "workspace:*",
        "spacegraphjs": "workspace:*"
    },
    "devDependencies": {
        "solid-js": "^1.9.0",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vite-plugin-solid": "2.11.10",
        "vitest": "^5.0.0"
    },
    "sideEffects": false
}
