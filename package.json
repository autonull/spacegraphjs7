{
  "name": "spacegraphjs",
  "version": "7.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activity": {
      "types": "./types/activity.d.ts",
      "default": "./src/activity.ts"
    },
    "./core": "./src/core/index.ts",
    "./edges": "./src/edges/index.ts",
    "./nodes": "./src/nodes/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/mermaid": "./src/plugins/mermaid/index.ts",
    "./input": "./src/input/index.ts",
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types.ts",
    "./builder": "./src/builder.ts",
    "./zoom": "./src/zoom/index.ts",
    "./layout": "./src/layout/index.ts",
    "./a11y": "./src/a11y/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./vision": "./src/vision/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm dlx vite --host",
    "dev:demo": "pnpm dlx vite --config vite.demo.config.ts --port 5173",
    "build": "pnpm run build:lib && pnpm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test",
    "clean": "rm -rf dist/ dist-demo/",
    "verify": "tsx verification/verify_demos.ts",
    "test": "vitest run",
    "test:vision": "mkdir -p test/fixtures/dist && cp -r dist/* test/fixtures/dist/ && cp -r public/*.onnx test/fixtures/dist/ && playwright test test/vision.spec.ts",
    "vision": "pnpm run test:vision",
    "lint": "eslint 'src/**/*.{ts,js}' --ignore-pattern 'dist'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc --options typedoc.json",
    "test:screenshots": "mkdir -p test/screenshots && playwright test test/e2e/demo-screenshots.spec.ts --reporter=list",
    "test:demo-errors": "playwright test test/e2e/demo-errors.spec.ts --reporter=list",
    "test:all-demos": "pnpm run test:demo-errors && pnpm run test:screenshots",
    "test:behavioral": "playwright test test/e2e/behavioral.spec.ts --reporter=list",
    "test:full": "pnpm test"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1",
    "katex": "^0.16.33",
    "marked": "^17.0.3",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "marked": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "canvas": "^3.2.3",
    "chart.js": "^4.5.1",
    "eslint": "^10.10.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonull/spacegraphjs.git"
  },
  "keywords": [
    "zui",
    "graph",
    "visualization",
    "three.js"
  ],
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "gsap": "^3.15.0",
    "mitt": "^3.0.1",
    "onnxruntime-web": "^1.29.0",
    "three-mesh-bvh": "^0.9.14"
  },
  "description": "[![pnpm](https://img.shields.io/pnpm/v/spacegraphjs.svg)](https://www.npmjs.com/package/spacegraphjs) [![Matrix](https://img.shields.io/matrix/spacegraphjs:matrix.org)](https://matrix.to/#/#spacegraphjs:matrix.org) [![GitHub Sponsors](https://img.shields.io/github/sponsors/autonull)](https://github.com/sponsors/autonull)",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/autonull/spacegraphjs/issues"
  },
  "homepage": "https://github.com/autonull/spacegraphjs#readme"
}
