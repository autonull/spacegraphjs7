    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "check": "pnpm run typecheck:root && pnpm -r --if-present typecheck",
        "check:docs-commands": "tsx script/check-docs-commands.ts",
        "check:evidence": "tsx script/evidence.ts",
        "check:evidence:write": "tsx script/evidence.ts --write",
        "check:generated": "tsx script/check-generated.ts",
        "check:labs": "tsx script/check-lab-catalogue.ts",
        "check:console-shots": "tsx script/check-console-shots.ts",
        "check:paths": "tsx script/check-paths.ts",
        "build": "pnpm run build:lib && pnpm run build:packages && pnpm run build:demo",
        "build:demo": "vite build --config app/demo/vite.config.ts",
        "build:lib": "vite build --config vite.lib.config.ts",
        "build:packages": "tsx script/build-packages.ts",
        "clean": "rm -rf dist/ dist-demo/ packages/*/dist/",
        "dev": "pnpm dlx vite --host",
        "dev:demo": "vite --config app/demo/vite.config.ts --port 5173",
        "explorer": "vite --config app/demo/vite.config.ts --port 5173 --open /explorer.html",
        "docs": "typedoc --options typedoc.json",
        "format": "prettier --write .",
        "generate:registry": "tsx script/generate-demo-registry.ts && prettier --write app/demo/src/registry.ts",
        "source:snapshot": "tsx script/source-snapshot.ts",
        "format:check": "prettier --check .",
        "lint": "eslint 'src/**/*.{ts,js}' --ignore-pattern 'dist'",
        "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test",
        "test": "vitest run",
        "typecheck:root": "tsc --noEmit -p tsconfig.json",
        "test:all-demos": "pnpm run test:demo-errors && pnpm run test:labs && pnpm run test:window && pnpm run test:team && pnpm run test:session && pnpm run test:screenshots",
        "test:behavioral": "playwright test test/interaction.spec.ts --reporter=list",
        "test:boundaries": "vitest run test/boundaries.test.ts",
        "test:demo-errors": "playwright test test/e2e/demo-errors.spec.ts --reporter=list",
        "test:labs": "playwright test test/e2e/labs-index.spec.ts --reporter=list",
        "test:window": "playwright test test/e2e/window-desktop.spec.ts --reporter=list",
        "test:team": "playwright test test/e2e/agent-team.spec.ts --reporter=list",
        "test:session": "playwright test test/e2e/dev-session.spec.ts --reporter=list",
        "test:exports": "vitest run test/package-exports.test.ts",
        "test:kernel": "pnpm --filter @spacegraphjs/kernel test",
        "test:atlas": "playwright test --config playwright.demo.config.ts test/e2e/interaction-atlas.spec.ts --reporter=list",
        "test:demo-atlas": "playwright test --config playwright.demo.config.ts test/e2e/demo-atlas.spec.ts --reporter=list",
        "test:inner-layout": "playwright test --config playwright.demo.config.ts test/e2e/inner-layout.spec.ts --reporter=list",
        "test:retro-style": "playwright test --config playwright.demo.config.ts test/e2e/retro-style.spec.ts --reporter=list",
        "verify:visual": "pnpm run test:atlas && pnpm run test:demo-atlas && pnpm run test:inner-layout && pnpm run test:retro-style",
        "test:full": "pnpm test && pnpm run test:kernel",
        "test:publish": "tsx script/publish-check.ts",
        "test:quickstart": "tsx script/quickstart-check.ts",
        "test:conformance": "vitest run test/conformance.test.ts packages/react-spacegraph/test/binding.test.ts packages/solid-spacegraph/test/binding.test.ts",
        "test:extension": "tsx script/extension-check.ts",
        "verify:library": "pnpm run check:docs-commands && pnpm run test:quickstart && pnpm run test:conformance && pnpm run test:extension && pnpm run check:generated && pnpm run check:labs && pnpm run check:console-shots && pnpm run check:paths",
        "test:explorer": "playwright test --config playwright.demo.config.ts test/e2e/explorer.spec.ts",
        "test:capture-matrix": "playwright test --config playwright.demo.config.ts test/e2e/capture-matrix.spec.ts",
        "test:screenshots": "mkdir -p screenshots && playwright test test/e2e/demo-screenshots.spec.ts --reporter=list",
        "test:vision": "rm -rf test/fixtures/dist && mkdir -p test/fixtures/dist && cp -r dist/* test/fixtures/dist/ && cp -r public/*.onnx test/fixtures/dist/ && playwright test test/vision.spec.ts",
        "verify": "tsx verification/capture.ts",
        "vision": "pnpm run test:vision",
        "write:exports": "tsx script/write-exports.ts",
        "build:all": "tsx script/build-all.ts"
    },
    "peerDependencies": {
        "chart.js": "^4.5.1",
        "katex": "^0.16.33",
        "three": ">=0.150.0"
    },
