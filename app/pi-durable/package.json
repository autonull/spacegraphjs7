{
    "name": "pi-durable",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "server": "tsx src/server.ts",
        "build": "vite build --config vite.config.ts",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "check:fast": "tsc --noEmit && vitest run --config vitest.config.ts",
        "test:e2e": "playwright test --config playwright.config.ts",
        "verify:fast": "pnpm run check:fast && pnpm run test:e2e",
        "verify": "tsx scripts/verify.ts",
        "verify:visual": "playwright test --config playwright.config.ts tests/screenshots.spec.ts tests/vision.spec.ts",
        "shot": "tsx scripts/shot.ts",
        "shots:all": "tsx scripts/shot.ts all",
        "shots:focus": "tsx scripts/shot.ts basic-turn,sleeping-approval,fork-tabs,resumed",
        "shots:phase2": "tsx scripts/shot.ts task-graph,timeline",
        "shots:watch": "tsx scripts/shot.ts --watch"
    },
    "dependencies": {
        "@earendil-works/chord": "1.6.0",
        "@earendil-works/pi-ai": "1.6.0",
        "@earendil-works/pi-durable": "1.6.0",
        "@earendil-works/pi-schema": "1.6.0",
        "@spacegraphjs/agent": "workspace:*",
        "@spacegraphjs/adapter": "workspace:*",
        "@spacegraphjs/kernel": "workspace:*",
        "@spacegraphjs/renderer": "workspace:*",
        "@spacegraphjs/shared": "workspace:*",
        "@spacegraphjs/spacegraph-renderer": "workspace:*",
        "pi-kit": "workspace:*",
        "spacegraphjs": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.4.1",
        "tsx": "^4.23.13",
        "typescript": "^5.9.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
