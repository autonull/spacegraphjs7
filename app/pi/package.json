{
    "name": "pi",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "server": "tsx src/server.ts",
        "build": "vite build --config vite.config.ts",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "check:fast": "tsc --noEmit && vitest run --config vitest.config.ts",
        "test:e2e": "playwright test --config playwright.config.ts",
        "e2e:chrome": "playwright test --config playwright.config.ts tests/shell.spec.ts tests/orchestration.spec.ts --fully-parallel",
        "verify:fast": "pnpm run check:fast && pnpm run e2e:chrome",
        "test:publish": "tsx scripts/publish-check.ts",
        "verify": "tsx scripts/verify.ts",
        "verify:visual": "playwright test --config playwright.config.ts tests/vision.spec.ts",
        "scale": "tsx scripts/scale.ts",
        "shot": "tsx scripts/shot.ts",
        "shots:all": "tsx scripts/shot.ts all",
        "compare:ui": "tsx scripts/ui-compare.ts",
        "shots:focus": "tsx scripts/shot.ts cockpit,node-detail,light-theme,policy",
        "shots:compare": "playwright test --config playwright.config.ts tests/ui-compare.spec.ts",
        "shots:watch": "tsx scripts/shot.ts --watch"
    },
    "dependencies": {
        "@earendil-works/pi-agent-core": "1.5.2",
        "@earendil-works/pi-ai": "1.5.2",
        "@earendil-works/pi-coding-agent": "1.5.2",
        "@spacegraphjs/agent": "workspace:*",
        "@spacegraphjs/adapter": "workspace:*",
        "@spacegraphjs/config": "workspace:*",
        "@spacegraphjs/kernel": "workspace:*",
        "@spacegraphjs/navigation": "workspace:*",
        "@spacegraphjs/renderer": "workspace:*",
        "@spacegraphjs/search": "workspace:*",
        "@spacegraphjs/shared": "workspace:*",
        "@spacegraphjs/spacegraph-renderer": "workspace:*",
        "spacegraphjs": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "tsx": "^4.23.13",
        "typescript": "^5.9.2",
        "vite": "^7.3.8",
        "vitest": "^5.0.5"
    }
}
