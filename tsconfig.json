{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "spacegraphjs": ["./src/index.ts"],
      "spacegraphjs/*": ["./src/*"],
      "@spacegraphjs/kernel": ["./packages/kernel/src/index.ts"],
      "@spacegraphjs/renderer": ["./packages/renderer/src/index.ts"],
      "@spacegraphjs/adapter": ["./packages/adapter/src/index.ts"],
      "@spacegraphjs/spacegraph-renderer": ["./packages/spacegraph-renderer/src/index.ts"],
      "@spacegraphjs/cytoscape-renderer": ["./packages/cytoscape-renderer/src/index.ts"],
      "@spacegraphjs/svg-renderer": ["./packages/svg-renderer/src/index.ts"],
      "@spacegraphjs/shared": ["./packages/shared/src/index.ts"],
      "@spacegraphjs/toolbar": ["./packages/toolbar/src/index.ts"],
      "@spacegraphjs/search": ["./packages/search/src/index.ts"],
      "@spacegraphjs/export": ["./packages/export/src/index.ts"],
      "@spacegraphjs/navigation": ["./packages/navigation/src/index.ts"],
      "@spacegraphjs/a11y": ["./packages/a11y/src/index.ts"],
      "@spacegraphjs/diff": ["./packages/diff/src/index.ts"],
      "@spacegraphjs/overlays": ["./packages/overlays/src/index.ts"],
      "@spacegraphjs/controls": ["./packages/controls/src/index.ts"],
      "@spacegraphjs/compare": ["./packages/compare/src/index.ts"],
      "@spacegraphjs/turn-map": ["./packages/turn-map/src/index.ts"],
      "@spacegraphjs/window-manager": ["./packages/window-manager/src/index.ts"],
      "@spacegraphjs/inspector": ["./packages/inspector/src/index.ts"]
    }
  },
  "include": ["src", "test", "demo/second-host"],
  "exclude": ["node_modules", "dist"]
}
